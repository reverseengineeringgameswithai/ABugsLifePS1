 "upload_path_family_B_2026-08-04": {
  "_comment": "Read from level_texture_stage 0x8003C8BC end to end with tools/mips_ea_window.c. Closes how the 4bpp/8bpp split reaches this consumer -- it DOES read the +10 flag, 0x298 bytes past the table fetch.",
  "depth_flag_consumer": "lh v1,10(s1) at 0x8003CB54. flag != 1 -> rect width w = (w+3)>>2 (4 pixels per 16-bit VRAM word = 4bpp); flag == 1 -> w = w>>1 (2 pixels per word = 8bpp). It rewrites the VRAM RECT width by pixel depth.",
  "CORRECTION_earlier_lead": "I named `andi v0,v0,3` at 0x8003C954 as the 4bpp/8bpp lead. WRONG -- it is `or v0,s0,a2` then `andi v0,v0,3`, an ALIGNMENT test choosing between a word copy and the lwl/lwr path. The real answer is the direct read at 0x8003CB54.",
  "rect": "A RECT is built at 0x80089848 (x @+0, y @+2, w @+4 = 0x8008984C, h @+6 = 0x8008984E) and passed to LoadImage 0x800628C0 as a0.",
  "pixel_source": "a1 = chunk + 12 + (palette_bytes & ~1)  -- the same `12 + round_down_even(u16@+8)` rule already pinned for the texture-page path, confirmed here independently.",
  "palette_pipeline": "The 768-byte palette is copied to a stack buffer (sp+32) and walked THREE BYTES AT A TIME -- code-level proof of 256 x RGB888 -- scaling each component to 75% via (v*96)>>7.",
  "colour_key": "Entries matching R<5 AND G>=250 AND B<5 are left UNSCALED (0x8003C9F0..0x8003CA28). That is the pure-green transparency key: in marker 0x30 exactly ONE palette entry matches (index 0 = (0,255,0)), it is what all four image corners use, and it is 50% of the image. Scaling it would turn 255 into 191 and break the key.",
  "two_clut_uploads": "level_texture_upload 0x8003CC58 is called twice -- once with the chunk's own palette (0x8003C944) and once with the 75%-scaled stack copy (0x8003CAE0) -- so a normal and a dimmed CLUT are both staged. The dimmed one being a menu 'unselected' variant is a READING, not established."
 },
 "visual_confirmation": {
  "method": "tools/phase4_e16_decode_registered_image.py renders a chunk with the consumer-derived layout; a wrong header reading produces noise, so recognisable art is an end-to-end confirmation of the format (including the palette being 256 x RGB888 on disc, not RGB555).",
  "LEVEL00/LEVEL.RAW marker 0x30": "menu icon -- a radio with music notes on a branch over a green key colour (160x132 8bpp)",
  "LEVEL00/LEVEL.RAW marker 0x43": "memory-card UI text atlas -- 'please wait / load / save / exit / 1 block used / not an \"a bug's life\" save game / press O to load' (256x256 8bpp)",
  "LEVEL00/LEVEL3.RAW marker 0x28": "the title screen -- 320x256 16bpp Disney/Pixar 'a bug's life' leaf logo",
  "note": "Renders are NOT committed: the source art is copyrighted. Regenerate locally with the decoder."
 },

 "format": {
  "family_A_markers_0x28_0x2F": {
   "header": "16 bytes: u32 marker @0, u32 width @+4, u32 height @+8, u32 @+12",
   "pixels": "16bpp direct colour at +16",
   "size_law": "size == 16 + width*height*2",
   "derivation": "the consumer reads `lw v0,4(s4)` / `lw v1,8(s4)` (32-bit) and calls LoadImage with `addiu a1,s4,16`"
  },
  "family_B_markers_0x30_0x5F": {
   "header": "12 bytes: u32 marker @0, u16 width @+4, u16 height @+6, u16 palette_bytes @+8, u16 depth_flag @+10",
   "palette": "palette_bytes immediately after the header (768 in 43/43)",
   "pixels": "indexed, after the palette; depth_flag 1 = 8bpp, 0 = 4bpp",
   "size_law": "size == 12 + palette_bytes + width*height/(1 if 8bpp else 2)",
   "derivation": "the consumers read `lhu` at +4/+6/+8(/+10) and take the payload from +12, then LoadImage / level_texture_upload"
  },
  "why_family_A_looked_malformed": "Read as u16, family A's 32-bit width/height make height and depth_flag look like 0 -- those are the high halves, not real fields.",
  "no_free_parameters": "Both laws come from the consumers, not from fitting sizes; each either holds exactly or does not."
